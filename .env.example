# Copie para .env e preencha com valores reais.
# Gere a SECRET_KEY com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

SECRET_KEY=troque-isso-por-uma-chave-aleatoria-longa
ALGORITHM=HS256
# Recomendado: 15 minutos quando o app já usar /auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=sqlite:///coach_pam.db

# Origens permitidas pelo CORS, separadas por vírgula.
# "*" libera todas — ok pra dev, NUNCA usar em produção.
# Exemplo prod: CORS_ORIGINS=https://app.coachpam.com,https://admin.coachpam.com
CORS_ORIGINS=*
