# Copie para .env e preencha com valores reais.
# Gere a SECRET_KEY com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

SECRET_KEY=troque-isso-por-uma-chave-aleatoria-longa
ALGORITHM=HS256
# Recomendado: 15 minutos quando o app já usar /auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=sqlite:///coach_pam.db

# Origens permitidas pelo CORS, separadas por vírgula.
# "*" libera todas — ok pra dev, NUNCA usar em produção.
# Exemplo prod: CORS_ORIGINS=https://app.coachpam.com,https://admin.coachpam.com
CORS_ORIGINS=*

# ---- Notificação push (ntfy.sh) ----
# Instale o app "ntfy" no celular, inscreva-se no tópico abaixo,
# e o backend vai mandar notificações push nesse tópico.
# Use um nome único e difícil de adivinhar (é segredo por obscuridade).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# ---- E-mail (opcional, se quiser alerta também por e-mail) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=app-password-de-16-caracteres
# ALERT_EMAIL_TO=eduardocoelho12y@gmail.com
